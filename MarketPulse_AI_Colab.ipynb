    "import sqlite3\n",
    "import pandas as pd\n",
    "\n",
    "def export_all_data():\n",
    "    \"\"\"Export database to CSV for backup\"\"\"\n",
    "    conn = sqlite3.connect(DB_PATH)\n",
    "    \n",
    "    tables = ['stocks', 'insights', 'videos', 'economy', 'news']\n",
    "    \n",
    "    print(\"\\n📦 EXPORTING DATA...\\n\")\n",
    "    \n",
    "    for table in tables:\n",
    "        try:\n",
    "            df = pd.read_sql_query(f'SELECT * FROM {table}', conn)\n",
    "            if not df.empty:\n",
    "                export_path = f'/content/{table}_export.csv'\n",
    "                df.to_csv(export_path, index=False)\n",
    "                print(f\"✅ Exported {table}: {len(df)} rows → {export_path}\")\n",
    "            else:\n",
    "                print(f\"⚠️  {table}: No data to export\")\n",
    "        except Exception as e:\n",
    "            print(f\"❌ Error exporting {table}: {e}\")\n",
    "    \n",
    "    conn.close()\n",
    "\nexport_all_data()\n\nprint(\"\\n\" + \"=\"*80)\nprint(\"✅ MARKETPULSE AI - COMPLETE SETUP FINISHED\")\nprint(\"=\"*80)\nprint(\"\"\"\n🎯 What we've built:\n\n1. ✅ Database Schema (SQLite)\n   - Stocks, insights, videos, economy, news tables\n   \n2. ✅ Data Fetcher\n   - yfinance integration for NSE stocks\n   - Technical indicators (SMA, RSI, Volume)\n   \n3. ✅ Analytics Engine\n   - High gainers detection (>5% daily)\n   - Unusual volume detection (3x+ average)\n   - 52-week high tracker\n   \n4. ✅ Insight Ranking\n   - Novelty, magnitude, trend, virality scoring\n   - Weighted final scores\n   \n5. ✅ Script Generator\n   - 30-second video scripts from insights\n   - Storyboard generation\n   \n6. ✅ Doodle Generator\n   - SVG-based visuals\n   - Candlestick charts, badges, title cards\n   \n7. ✅ Video Renderer\n   - MoviePy integration\n   - 1080x1920 format (Instagram Reels)\n   \n8. ✅ Daily Pipeline\n   - Complete workflow orchestration\n   - Automated insight-to-video pipeline\n   \n9. ✅ Analytics Dashboard\n   - Query and visualize data\n   - Performance statistics\n   \n10. ✅ Configuration & Export\n    - Config management\n    - CSV export for backups\n\n📊 Next Steps:\n\n1. Set up YouTube API credentials\n2. Configure Instagram upload tokens\n3. Deploy to cloud (AWS, GCP, or Heroku)\n4. Set up daily cron job\n5. Monitor and iterate on scoring algorithm\n6. Build social media presence\n\n🚀 To run daily:\n   pipeline.run_daily_pipeline()\n\"\"\")\nprint(\"=\"*80)"
