   "source": [
    "## Part 1: Database Setup"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "import sqlite3\n",
    "import os\n",
    "from datetime import datetime, timedelta\n",
    "import json\n",
    "\n",
    "# Create database\n",
    "DB_PATH = '/content/marketpulse.db'\n",
    "\n",
    "def init_database():\n",
    "    \"\"\"Initialize SQLite database with all required tables\"\"\"\n",
    "    conn = sqlite3.connect(DB_PATH)\n",
    "    cursor = conn.cursor()\n",
    "    \n",
    "    # Stocks table\n",
    "    cursor.execute('''\n",
    "        CREATE TABLE IF NOT EXISTS stocks (\n",
    "            id INTEGER PRIMARY KEY AUTOINCREMENT,\n",
    "            ticker TEXT NOT NULL,\n",
    "            date DATE NOT NULL,\n",
    "            open REAL,\n",
    "            high REAL,\n",
    "            low REAL,\n",
    "            close REAL,\n",
    "            volume INTEGER,\n",
    "            sma_20 REAL,\n",
    "            sma_200 REAL,\n",
    "            rsi REAL,\n",
    "            volume_avg_20 REAL,\n",
    "            prev_close REAL,\n",
    "            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,\n",
    "            UNIQUE(ticker, date)\n",
    "        )\n",
    "    ''')\n",
    "    \n",
    "    # 52-week highs/lows\n",
    "    cursor.execute('''\n",
    "        CREATE TABLE IF NOT EXISTS weekly_metrics (\n",
    "            id INTEGER PRIMARY KEY AUTOINCREMENT,\n",
    "            ticker TEXT NOT NULL,\n",
    "            date DATE NOT NULL,\n",
    "            week_52_high REAL,\n",
    "            week_52_low REAL,\n",
    "            market_cap REAL,\n",
    "            pe_ratio REAL,\n",
    "            UNIQUE(ticker, date)\n",
    "        )\n",
    "    ''')\n",
    "    \n",
    "    # Insights table\n",
    "    cursor.execute('''\n",
    "        CREATE TABLE IF NOT EXISTS insights (\n",
    "            id INTEGER PRIMARY KEY AUTOINCREMENT,\n",
    "            date DATE NOT NULL,\n",
    "            insight_type TEXT NOT NULL,\n",
    "            ticker TEXT,\n",
    "            headline TEXT NOT NULL,\n",
    "            description TEXT,\n",
    "            magnitude REAL,\n",
    "            novelty_score REAL,\n",
    "            virality_score REAL,\n",
    "            final_score REAL,\n",
    "            video_generated BOOLEAN DEFAULT 0,\n",
    "            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP\n",
    "        )\n",
    "    ''')\n",
    "    \n",
    "    # Videos table\n",
    "    cursor.execute('''\n",
    "        CREATE TABLE IF NOT EXISTS videos (\n",
    "            id INTEGER PRIMARY KEY AUTOINCREMENT,\n",
    "            insight_id INTEGER,\n",
    "            date DATE NOT NULL,\n",
    "            script TEXT,\n",
    "            video_path TEXT,\n",
    "            thumbnail_path TEXT,\n",
    "            upload_status TEXT DEFAULT 'ready',\n",
    "            youtube_id TEXT,\n",
    "            instagram_id TEXT,\n",
    "            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,\n",
    "            FOREIGN KEY(insight_id) REFERENCES insights(id)\n",
    "        )\n",
    "    ''')\n",
    "    \n",
    "    # Economy data\n",
    "    cursor.execute('''\n",
    "        CREATE TABLE IF NOT EXISTS economy (\n",
    "            id INTEGER PRIMARY KEY AUTOINCREMENT,\n",
    "            date DATE NOT NULL,\n",
    "            repo_rate REAL,\n",
    "            inflation REAL,\n",
    "            gold_price REAL,\n",
    "            usd_inr REAL,\n",
    "            nifty_50 REAL,\n",
    "            sensex REAL,\n",
    "            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,\n",
    "            UNIQUE(date)\n",
    "        )\n",
    "    ''')\n",
    "    \n",
    "    # News/Headlines\n",
    "    cursor.execute('''\n",
    "        CREATE TABLE IF NOT EXISTS news (\n",
    "            id INTEGER PRIMARY KEY AUTOINCREMENT,\n",
    "            title TEXT NOT NULL,\n",
    "            source TEXT,\n",
    "            date DATE NOT NULL,\n",
    "            sentiment TEXT,\n",
    "            ticker TEXT,\n",
    "            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP\n",
    "        )\n",
    "    ''')\n",
    "    \n",
    "    conn.commit()\n",
    "    conn.close()\n",
    "    print(f\"✅ Database initialized at {DB_PATH}\")\n",
    "\n",
    "init_database()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Part 2: Data Fetcher (yfinance)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "import yfinance as yf\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "from datetime import datetime, timedelta\n",
    "\n",
    "class DataFetcher:\n",
    "    \"\"\"Fetch stock data from yfinance and store in database\"\"\"\n",
    "    \n",
    "    # Top NSE stocks\n",
    "    NSE_TICKERS = [\n",
    "        'RELIANCE.NS', 'TCS.NS', 'HDFCBANK.NS', 'INFY.NS', 'HDFC.NS',\n",
    "        'LT.NS', 'ITC.NS', 'ADANIPOWER.NS', 'BAJAJFINSV.NS', 'KOTAKBANK.NS',\n",
    "        'SBIN.NS', 'MARUTI.NS', 'SUNPHARMA.NS', 'ASIANPAINT.NS', 'DMART.NS',\n",
    "        'AXISBANK.NS', 'WIPRO.NS', 'BAJAJ-AUTO.NS', 'HCLTECH.NS', 'TECHM.NS'\n",
    "    ]\n",
    "    \n",
    "    # Indices\n",
    "    INDICES = {\n",
    "        'NIFTY_50': '^NSEI',\n",
    "        'SENSEX': '^BSESN',\n",
    "        'GOLD': 'GOLD.NS',\n",
    "        'USD_INR': 'USDINR=X',\n",
    "        'BTC_USD': 'BTC-USD'\n",
    "    }\n",
    "    \n",
    "    @staticmethod\n",
    "    def fetch_stock_data(ticker, period='1y'):\n",
    "        \"\"\"Fetch historical data for a ticker\"\"\"\n",
    "        try:\n",
    "            data = yf.download(ticker, period=period, progress=False)\n",
    "            return data\n",
    "        except Exception as e:\n",
    "            print(f\"❌ Error fetching {ticker}: {e}\")\n",
    "            return None\n",
    "    \n",
    "    @staticmethod\n",
    "    def calculate_indicators(data):\n",
    "        \"\"\"Calculate technical indicators\"\"\"\n",
    "        # Simple Moving Averages\n",
    "        data['SMA_20'] = data['Close'].rolling(window=20).mean()\n",
    "        data['SMA_200'] = data['Close'].rolling(window=200).mean()\n",
    "        \n",
    "        # RSI (Relative Strength Index)\n",
    "        delta = data['Close'].diff()\n",
    "        gain = (delta.where(delta > 0, 0)).rolling(window=14).mean()\n",
    "        loss = (-delta.where(delta < 0, 0)).rolling(window=14).mean()\n",
    "        rs = gain / loss\n",
    "        data['RSI'] = 100 - (100 / (1 + rs))\n",
    "        \n",
    "        # Volume Average (20 days)\n",
    "        data['Volume_Avg_20'] = data['Volume'].rolling(window=20).mean()\n",
    "        \n",
    "        return data\n",
    "    \n",
    "    @staticmethod\n",
    "    def store_stock_data(ticker, data):\n",
    "        \"\"\"Store calculated data in database\"\"\"\n",
    "        conn = sqlite3.connect(DB_PATH)\n",
    "        cursor = conn.cursor()\n",
    "        \n",
    "        for date, row in data.iterrows():\n",
    "            try:\n",
    "                cursor.execute('''\n",
    "                    INSERT OR REPLACE INTO stocks \n",
    "                    (ticker, date, open, high, low, close, volume, sma_20, sma_200, rsi, volume_avg_20, prev_close)\n",
    "                    VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)\n",
    "                ''', (\n",
    "                    ticker,\n",
    "                    date.strftime('%Y-%m-%d'),\n",
    "                    float(row['Open']),\n",
    "                    float(row['High']),\n",
    "                    float(row['Low']),\n",
    "                    float(row['Close']),\n",
    "                    int(row['Volume']),\n",
    "                    float(row['SMA_20']) if pd.notna(row['SMA_20']) else None,\n",
    "                    float(row['SMA_200']) if pd.notna(row['SMA_200']) else None,\n",
    "                    float(row['RSI']) if pd.notna(row['RSI']) else None,\n",
    "                    float(row['Volume_Avg_20']) if pd.notna(row['Volume_Avg_20']) else None,\n",
    "                    float(row['Close'])  # prev_close for now\n",
    "                ))\n",
    "            except Exception as e:\n",
    "                print(f\"Error storing {ticker} on {date}: {e}\")\n",
    "        \n",
    "        conn.commit()\n",
    "        conn.close()\n",
    "        print(f\"✅ Stored {len(data)} records for {ticker}\")\n",
    "\n",
    "# Test fetcher\n",
    "print(\"🔄 Fetching sample data for Reliance...\")\n",
    "data = DataFetcher.fetch_stock_data('RELIANCE.NS', period='3mo')\n",
    "if data is not None:\n",
    "    data = DataFetcher.calculate_indicators(data)\n",
    "    DataFetcher.store_stock_data('RELIANCE.NS', data)\n",
    "    print(f\"Sample data shape: {data.shape}\")"
   ]
  },
