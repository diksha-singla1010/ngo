    "## Part 8: Complete Daily Pipeline"
   ]
  },
  {
   "cell_type": "code">
   "execution_count": null,
   "metadata": {},
   "source": [
    "import sqlite3\n",
    "from datetime import datetime, timedelta\n",
    "\n",
    "class DailyPipeline:\n",
    "    \"\"\"Complete daily workflow orchestrator\"\"\"\n",
    "    \n",
    "    def __init__(self, db_path):\n",
    "        self.db_path = db_path\n",
    "        self.fetcher = DataFetcher\n",
    "        self.ig = InsightGenerator(db_path)\n",
    "        self.ranker = InsightRanker\n",
    "        self.script_gen = ScriptGenerator\n",
    "        self.doodle_gen = DoodleGenerator\n",
    "        self.renderer = VideoRenderer\n",
    "    \n",
    "    def run_daily_pipeline(self):\n",
    "        \"\"\"Execute complete daily pipeline\"\"\"\n",
    "        \n",
    "        print(\"\\n\" + \"=\"*60)\n",
    "        print(\"🚀 MARKETPULSE AI - DAILY PIPELINE START\")\n",
    "        print(\"=\"*60)\n",
    "        print(f\"⏰ Started at: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\")\n",
    "        \n",
    "        # Step 1: Fetch data\n",
    "        print(\"\\n📊 Step 1: Fetching market data...\")\n",
    "        self._fetch_data()\n",
    "        \n",
    "        # Step 2: Generate insights\n",
    "        print(\"\\n💡 Step 2: Generating insights...\")\n",
    "        insights = self.ig.generate_all_insights()\n",
    "        print(f\"   Generated {len(insights)} insights\")\n",
    "        \n",
    "        # Step 3: Rank insights\n",
    "        print(\"\\n📈 Step 3: Ranking insights...\")\n",
    "        ranked_insights = self.ranker.rank_insights(insights)\n",
    "        print(f\"   Top insight score: {ranked_insights[0]['final_score']:.2f}\" if ranked_insights else \"   No insights\")\n",
    "        \n",
    "        # Step 4: Select top insights for video\n",
    "        print(\"\\n🎬 Step 4: Selecting insights for videos...\")\n",
    "        top_insights = ranked_insights[:3]  # Top 3\n",
    "        self._store_insights(top_insights)\n",
    "        \n",
    "        # Step 5: Generate scripts\n",
    "        print(\"\\n✍️  Step 5: Generating scripts...\")\n",
    "        videos = []\n",
    "        for i, insight in enumerate(top_insights, 1):\n",
    "            script = self.script_gen.generate_script(insight)\n",
    "            storyboard = self.script_gen.generate_storyboard(script, insight)\n",
    "            videos.append({\n",
    "                'insight': insight,\n",
    "                'script': script,\n",
    "                'storyboard': storyboard\n",
    "            })\n",
    "            print(f\"   Script {i} created\")\n",
    "        \n",
    "        # Step 6: Generate doodles\n",
    "        print(\"\\n🎨 Step 6: Generating doodles...\")\n",
    "        for i, video in enumerate(videos, 1):\n",
    "            title = video['insight']['headline']\n",
    "            magnitude = video['insight']['magnitude']\n",
    "            doodles = {\n",
    "                'title': self.doodle_gen.create_title_card(title.split()[0], f\"Change: {magnitude:.2f}\"),\n",
    "                'chart': self.doodle_gen.create_candlestick_chart([100, 105, 103, 108, 110]),\n",
    "                'badge': self.doodle_gen.create_percentage_badge(magnitude)\n",
    "            }\n",
    "            video['doodles'] = doodles\n",
    "            print(f\"   Doodles {i} created\")\n",
    "        \n",
    "        # Summary\n",
    "        print(\"\\n\" + \"=\"*60)\n",
    "        print(\"✅ PIPELINE COMPLETE\")\n",
    "        print(\"=\"*60)\n",
    "        print(f\"📹 Videos ready: {len(videos)}\")\n",
    "        print(f\"⏰ Completed at: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\")\n",
    "        print(\"\\n📊 VIDEO SUMMARY:\")\n",
    "        for i, video in enumerate(videos, 1):\n",
    "            print(f\"\\n  Video {i}:\")\n",
    "            print(f\"  - Insight: {video['insight']['headline']}\")\n",
    "            print(f\"  - Score: {video['insight']['final_score']:.2f}\")\n",
    "            print(f\"  - Magnitude: {video['insight']['magnitude']:.2f}\")\n",
    "        \n",
    "        return videos\n",
    "    \n",
    "    def _fetch_data(self):\n",
    "        \"\"\"Fetch data for key tickers\"\"\"\n",
    "        tickers = ['RELIANCE.NS', 'TCS.NS', 'HDFCBANK.NS']\n",
    "        for ticker in tickers:\n",
    "            print(f\"   Fetching {ticker}...\")\n",
    "            try:\n",
    "                data = self.fetcher.fetch_stock_data(ticker, period='3mo')\n",
    "                if data is not None:\n",
    "                    data = self.fetcher.calculate_indicators(data)\n",
    "                    self.fetcher.store_stock_data(ticker, data)\n",
    "            except Exception as e:\n",
    "                print(f\"   Error with {ticker}: {e}\")\n",
    "    \n",
    "    def _store_insights(self, insights):\n",
    "        \"\"\"Store insights in database\"\"\"\n",
    "        conn = sqlite3.connect(self.db_path)\n",
    "        cursor = conn.cursor()\n",
    "        \n",
    "        for insight in insights:\n",
    "            cursor.execute('''\n",
    "                INSERT INTO insights \n",
    "                (date, insight_type, ticker, headline, description, magnitude, \n",
    "                 novelty_score, virality_score, final_score)\n",
    "                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)\n",
    "            ''', (\n",
    "                datetime.now().date(),\n",
    "                insight['type'],\n",
    "                insight.get('ticker', ''),\n",
    "                insight['headline'],\n",
    "                insight['description'],\n",
    "                insight['magnitude'],\n",
    "                insight.get('scores', {}).get('novelty', 0),\n",
    "                insight.get('scores', {}).get('virality', 0),\n",
    "                insight['final_score']\n",
    "            ))\n",
    "        \n",
    "        conn.commit()\n",
    "        conn.close()\n",
    "\n",
    "# Run the pipeline\n",
    "print(\"\\n🔄 Starting MarketPulse AI daily pipeline...\\n\")\n",
    "pipeline = DailyPipeline(DB_PATH)\n",
    "videos = pipeline.run_daily_pipeline()"
   ]
