    "## Part 6: Doodle Generator (SVG)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "import base64\n",
    "from datetime import datetime\n",
    "\n",
    "class DoodleGenerator:\n",
    "    \"\"\"Generate SVG doodles for video\"\"\"\n",
    "    \n",
    "    @staticmethod\n",
    "    def create_candlestick_chart(prices, width=800, height=400):\n",
    "        \"\"\"Create a simple candlestick chart SVG\"\"\"\n",
    "        \n",
    "        # Normalize prices to fit in SVG\n",
    "        min_price = min(prices)\n",
    "        max_price = max(prices)\n",
    "        price_range = max_price - min_price if max_price > min_price else 1\n",
    "        \n",
    "        margin = 50\n",
    "        chart_width = width - 2 * margin\n",
    "        chart_height = height - 2 * margin\n",
    "        \n",
    "        candles = []\n",
    "        for i, price in enumerate(prices):\n",
    "            x = margin + (i / len(prices)) * chart_width\n",
    "            y = height - margin - ((price - min_price) / price_range) * chart_height\n",
    "            candles.append((x, y))\n",
    "        \n",
    "        svg = f'''<svg width=\"{width}\" height=\"{height}\" xmlns=\"http://www.w3.org/2000/svg\">\n",
    "            <!-- Background -->\n",
    "            <rect width=\"{width}\" height=\"{height}\" fill=\"#ffffff\"/>\n",
    "            \n",
    "            <!-- Grid -->\n",
    "            <line x1=\"{margin}\" y1=\"{margin}\" x2=\"{margin}\" y2=\"{height-margin}\" stroke=\"#cccccc\" stroke-width=\"2\"/>\n",
    "            <line x1=\"{margin}\" y1=\"{height-margin}\" x2=\"{width-margin}\" y2=\"{height-margin}\" stroke=\"#cccccc\" stroke-width=\"2\"/>\n",
    "            \n",
    "            <!-- Candlesticks -->\n",
    "        '''\n",
    "        \n",
    "        for i in range(len(candles)-1):\n",
    "            x1, y1 = candles[i]\n",
    "            x2, y2 = candles[i+1]\n",
    "            color = '#22c55e' if y2 < y1 else '#ef4444'  # Green if up, red if down\n",
    "            \n",
    "            svg += f'<line x1=\"{x1}\" y1=\"{y1}\" x2=\"{x2}\" y2=\"{y2}\" stroke=\"{color}\" stroke-width=\"3\" stroke-linecap=\"round\"/>' + '\\n'\n",
    "            svg += f'<circle cx=\"{x2}\" cy=\"{y2}\" r=\"4\" fill=\"{color}\"/>' + '\\n'\n",
    "        \n",
    "        svg += '</svg>'\n",
    "        return svg\n",
    "    \n",
    "    @staticmethod\n",
    "    def create_percentage_badge(percentage):\n",
    "        \"\"\"Create a percentage badge SVG\"\"\"\n",
    "        color = '#22c55e' if percentage > 0 else '#ef4444'\n",
    "        symbol = '↑' if percentage > 0 else '↓'\n",
    "        \n",
    "        svg = f'''<svg width=\"200\" height=\"100\" xmlns=\"http://www.w3.org/2000/svg\">\n",
    "            <rect x=\"10\" y=\"10\" width=\"180\" height=\"80\" rx=\"10\" fill=\"{color}\" opacity=\"0.1\" stroke=\"{color}\" stroke-width=\"2\"/>\n",
    "            <text x=\"100\" y=\"70\" font-size=\"48\" font-weight=\"bold\" fill=\"{color}\" text-anchor=\"middle\" font-family=\"Arial\">{abs(percentage):.1f}%</text>\n",
    "            <text x=\"160\" y=\"50\" font-size=\"36\" fill=\"{color}\" font-family=\"Arial\">{symbol}</text>\n",
    "        </svg>'''\n",
    "        \n",
    "        return svg\n",
    "    \n",
    "    @staticmethod\n",
    "    def create_title_card(title, subtitle):\n",
    "        \"\"\"Create title card SVG\"\"\"\n",
    "        svg = f'''<svg width=\"1080\" height=\"1920\" xmlns=\"http://www.w3.org/2000/svg\">\n",
    "            <!-- Gradient background -->\n",
    "            <defs>\n",
    "                <linearGradient id=\"grad1\" x1=\"0%\" y1=\"0%\" x2=\"0%\" y2=\"100%\">\n",
    "                    <stop offset=\"0%\" style=\"stop-color:#1a1a2e;stop-opacity:1\" />\n",
    "                    <stop offset=\"100%\" style=\"stop-color:#0f3460;stop-opacity:1\" />\n",
    "                </linearGradient>\n",
    "            </defs>\n",
    "            <rect width=\"1080\" height=\"1920\" fill=\"url(#grad1)\"/>\n",
    "            \n",
    "            <!-- Title -->\n",
    "            <text x=\"540\" y=\"800\" font-size=\"72\" font-weight=\"bold\" fill=\"#ffffff\" text-anchor=\"middle\" font-family=\"Arial\">{title}</text>\n",
    "            \n",
    "            <!-- Subtitle -->\n",
    "            <text x=\"540\" y=\"1000\" font-size=\"48\" fill=\"#e0e0e0\" text-anchor=\"middle\" font-family=\"Arial\">{subtitle}</text>\n",
    "            \n",
    "            <!-- Decorative elements -->\n",
    "            <circle cx=\"200\" cy=\"300\" r=\"80\" fill=\"#e94560\" opacity=\"0.3\"/>\n",
    "            <circle cx=\"880\" cy=\"1700\" r=\"100\" fill=\"#6c63ff\" opacity=\"0.3\"/>\n",
    "            <polygon points=\"540,200 800,400 280,400\" fill=\"#22c55e\" opacity=\"0.2\"/>\n",
    "        </svg>'''\n",
    "        \n",
    "        return svg\n",
    "\n",
    "# Test doodle generator\n",
    "print(\"🔄 Generating doodles...\")\n",
    "sample_prices = [100, 105, 103, 108, 110, 107, 115, 112]\n",
    "chart_svg = DoodleGenerator.create_candlestick_chart(sample_prices)\n",
    "badge_svg = DoodleGenerator.create_percentage_badge(12.5)\n",
    "title_svg = DoodleGenerator.create_title_card('RELIANCE', 'Up 12.5% Today')\n",
    "print(f\"✅ Chart SVG length: {len(chart_svg)} chars\")\n",
    "print(f\"✅ Badge SVG length: {len(badge_svg)} chars\")\n",
    "print(f\"✅ Title SVG length: {len(title_svg)} chars\")"
   ]
