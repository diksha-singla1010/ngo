   "source": [
    "## Part 4: Insight Ranking Engine"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "from datetime import datetime, timedelta\n",
    "\n",
    "class InsightRanker:\n",
    "    \"\"\"Rank insights by novelty, magnitude, virality, and relevance\"\"\"\n",
    "    \n",
    "    SCORING_WEIGHTS = {\n",
    "        'novelty': 0.25,\n",
    "        'magnitude': 0.25,\n",
    "        'trend': 0.20,\n",
    "        'virality': 0.20,\n",
    "        'relevance': 0.10\n",
    "    }\n",
    "    \n",
    "    @staticmethod\n",
    "    def score_novelty(insight_type, frequency_today):\n",
    "        \"\"\"Score based on how often this type appears today\n",
    "        Lower frequency = higher novelty\n",
    "        \"\"\"\n",
    "        if frequency_today == 0:\n",
    "            return 100\n",
    "        elif frequency_today == 1:\n",
    "            return 75\n",
    "        elif frequency_today <= 3:\n",
    "            return 50\n",
    "        else:\n",
    "            return 25\n",
    "    \n",
    "    @staticmethod\n",
    "    def score_magnitude(magnitude, insight_type):\n",
    "        \"\"\"Score based on how big the move is\"\"\"\n",
    "        if insight_type == 'HIGH_GAINER':\n",
    "            # 5% = 50, 10% = 100, >15% = 100\n",
    "            return min(100, (magnitude - 5) * 10)\n",
    "        elif insight_type == 'UNUSUAL_VOLUME':\n",
    "            # 3x = 33, 5x = 67, 10x+ = 100\n",
    "            return min(100, (magnitude - 3) * 20)\n",
    "        else:\n",
    "            return 70  # 52W_HIGH always moderate\n",
    "    \n",
    "    @staticmethod\n",
    "    def score_virality(insight_type, magnitude):\n",
    "        \"\"\"Score based on potential virality\"\"\"\n",
    "        base_scores = {\n",
    "            'HIGH_GAINER': 80,\n",
    "            'UNUSUAL_VOLUME': 60,\n",
    "            '52W_HIGH': 50\n",
    "        }\n",
    "        \n",
    "        base = base_scores.get(insight_type, 50)\n",
    "        magnitude_boost = min(20, magnitude / 10)\n",
    "        return min(100, base + magnitude_boost)\n",
    "    \n",
    "    @staticmethod\n",
    "    def score_trend(ticker):\n",
    "        \"\"\"Check if ticker is in trending companies\"\"\"\n",
    "        trending = ['RELIANCE.NS', 'TCS.NS', 'HDFCBANK.NS', 'INFY.NS']\n",
    "        return 80 if ticker in trending else 50\n",
    "    \n",
    "    @staticmethod\n",
    "    def score_relevance(insight_type):\n",
    "        \"\"\"Relevance score for insight type\"\"\"\n",
    "        scores = {\n",
    "            'HIGH_GAINER': 100,      # Most relevant\n",
    "            'UNUSUAL_VOLUME': 85,\n",
    "            '52W_HIGH': 70\n",
    "        }\n",
    "        return scores.get(insight_type, 50)\n",
    "    \n",
    "    @classmethod\n",
    "    def rank_insights(cls, insights):\n",
    "        \"\"\"Calculate final scores for all insights\"\"\"\n",
    "        \n",
    "        # Count frequencies\n",
    "        type_freq = {}\n",
    "        for insight in insights:\n",
    "            t = insight['type']\n",
    "            type_freq[t] = type_freq.get(t, 0) + 1\n",
    "        \n",
    "        ranked = []\n",
    "        for insight in insights:\n",
    "            scores = {\n",
    "                'novelty': cls.score_novelty(insight['type'], type_freq.get(insight['type'], 0)),\n",
    "                'magnitude': cls.score_magnitude(insight['magnitude'], insight['type']),\n",
    "                'trend': cls.score_trend(insight.get('ticker', '')),\n",
    "                'virality': cls.score_virality(insight['type'], insight['magnitude']),\n",
    "                'relevance': cls.score_relevance(insight['type'])\n",
    "            }\n",
    "            \n",
    "            # Calculate weighted final score\n",
    "            final_score = sum(scores[k] * cls.SCORING_WEIGHTS[k] for k in scores)\n",
    "            \n",
    "            ranked.append({\n",
    "                **insight,\n",
    "                'scores': scores,\n",
    "                'final_score': round(final_score, 2)\n",
    "            })\n",
    "        \n",
    "        # Sort by final score\n",
    "        ranked.sort(key=lambda x: x['final_score'], reverse=True)\n",
    "        return ranked\n",
    "\n",
    "# Test ranker\n",
    "print(\"🔄 Ranking insights...\")\n",
    "test_insights = [\n",
    "    {'type': 'HIGH_GAINER', 'ticker': 'RELIANCE.NS', 'magnitude': 12.5, 'headline': 'Reliance +12.5%', 'description': 'Big move'},\n",
    "    {'type': 'UNUSUAL_VOLUME', 'ticker': 'TCS.NS', 'magnitude': 4.2, 'headline': 'TCS 4.2x volume', 'description': 'Unusual activity'},\n",
    "    {'type': '52W_HIGH', 'ticker': 'HDFCBANK.NS', 'magnitude': 1800, 'headline': 'HDFC 52W High', 'description': 'New high'},\n",
    "]\n",
    "ranked = InsightRanker.rank_insights(test_insights)\n",
    "print(\"✅ Top insights:\")\n",
    "for r in ranked[:3]:\n",
    "    print(f\"  Score: {r['final_score']:.2f} | {r['headline']}\")"
   ]
