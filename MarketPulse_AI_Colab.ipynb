    "            'music': 'upbeat_instrumental',\n",
    "            'background': 'gradient_dark'\n",
    "        }\n",
    "        \n",
    "        return storyboard\n",
    "\n",
    "# Test script generator\n",
    "print(\"🔄 Generating script...\")\n",
    "test_insight = {\n",
