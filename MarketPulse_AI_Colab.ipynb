   "source": [
    "## Part 5: LLM Script Generator"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "import os\n",
    "from datetime import datetime\n",
    "\n",
    "class ScriptGenerator:\n",
    "    \"\"\"Generate 30-second video scripts using LLM\"\"\"\n",
    "    \n",
    "    # For now, using template-based approach (no API key required)\n",
    "    \n",
    "    @staticmethod\n",
    "    def generate_script(insight):\n",
    "        \"\"\"Generate a 30-second script for an insight\"\"\"\n",
    "        \n",
    "        templates = {\n",
    "            'HIGH_GAINER': '''🚀 MARKET SURPRISE\n\n\"{headline}\" — That's the biggest move in {time}.\n\nWhat changed? Let's check the details.\n\n[SHOW CHART]\n\nVolume: {volume_info}\nTechnical: {technical_info}\n\nThis is why {ticker} moved today.''',\n",
    "            \n",
    "            'UNUSUAL_VOLUME': '''📊 UNUSUAL ACTIVITY\n\n\"{headline}\" — Something's happening.\n\nVolume is {magnitude}x higher than normal.\n\n[SHOW CHART]\n\nBiggest moves today:\n{price_change}\n\nWatch closely.''',\n",
    "            \n",
    "            '52W_HIGH': '''📈 NEW RECORD\n\n\"{headline}\" — Highest in {time}.\n\nHere's what this means:\n\n[SHOW CHART]\n\nCompare to market:\n{market_comparison}\n\nStrong performance.'''\n",
    "        }\n",
    "        \n",
    "        template = templates.get(insight['type'], '')\n",
    "        \n",
    "        # Simple placeholder replacement\n",
    "        script = template.format(\n",
    "            headline=insight['headline'],\n",
    "            ticker=insight.get('ticker', 'Stock'),\n",
    "            time='months',\n",
