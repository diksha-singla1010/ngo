   "source": [
    "## Part 3: Analytics Engine - Insight Generation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "import sqlite3\n",
    "import pandas as pd\n",
    "from datetime import datetime, timedelta\n",
    "\n",
    "class InsightGenerator:\n",
    "    \"\"\"Generate trading insights from market data\"\"\"\n",
    "    \n",
    "    def __init__(self, db_path):\n",
    "        self.db_path = db_path\n",
    "    \n",
    "    def get_today_data(self):\n",
    "        \"\"\"Get today's market data\"\"\"\n",
    "        conn = sqlite3.connect(self.db_path)\n",
    "        query = '''\n",
    "            SELECT * FROM stocks \n",
    "            WHERE date = (SELECT MAX(date) FROM stocks)\n",
    "            ORDER BY ticker\n",
    "        '''\n",
    "        df = pd.read_sql_query(query, conn)\n",
    "        conn.close()\n",
    "        return df\n",
    "    \n",
    "    def detect_high_gainers(self):\n",
    "        \"\"\"Detect stocks with >5% daily gain\"\"\"\n",
    "        conn = sqlite3.connect(self.db_path)\n",
    "        query = '''\n",
    "            SELECT ticker, close, \n",
    "                   ROUND(((close - prev_close) / prev_close * 100), 2) as return_pct\n",
    "            FROM stocks\n",
    "            WHERE date = (SELECT MAX(date) FROM stocks)\n",
    "            AND ((close - prev_close) / prev_close * 100) > 5\n",
    "            ORDER BY return_pct DESC\n",
    "        '''\n",
    "        df = pd.read_sql_query(query, conn)\n",
    "        conn.close()\n",
    "        \n",
    "        insights = []\n",
    "        for _, row in df.iterrows():\n",
    "            insights.append({\n",
    "                'type': 'HIGH_GAINER',\n",
    "                'ticker': row['ticker'],\n",
    "                'magnitude': float(row['return_pct']),\n",
    "                'headline': f\"{row['ticker']} surged {row['return_pct']:.2f}% today\",\n",
    "                'description': f\"Biggest daily jump in multiple months\"\n",
    "            })\n",
    "        \n",
    "        return insights\n",
    "    \n",
    "    def detect_unusual_volume(self):\n",
    "        \"\"\"Detect stocks with 3x+ average volume\"\"\"\n",
    "        conn = sqlite3.connect(self.db_path)\n",
    "        query = '''\n",
    "            SELECT ticker, volume, volume_avg_20,\n",
    "                   ROUND((volume / volume_avg_20), 2) as volume_ratio\n",
    "            FROM stocks\n",
    "            WHERE date = (SELECT MAX(date) FROM stocks)\n",
    "            AND volume_avg_20 IS NOT NULL\n",
    "            AND (volume / volume_avg_20) > 3\n",
    "            ORDER BY volume_ratio DESC\n",
    "        '''\n",
    "        df = pd.read_sql_query(query, conn)\n",
    "        conn.close()\n",
    "        \n",
    "        insights = []\n",
    "        for _, row in df.iterrows():\n",
    "            insights.append({\n",
    "                'type': 'UNUSUAL_VOLUME',\n",
    "                'ticker': row['ticker'],\n",
    "                'magnitude': float(row['volume_ratio']),\n",
    "                'headline': f\"{row['ticker']} saw {row['volume_ratio']:.1f}x average volume\",\n",
    "                'description': f\"Unusual buying/selling detected\"\n",
    "            })\n",
    "        \n",
    "        return insights\n",
    "    \n",
    "    def detect_52_week_high(self):\n",
    "        \"\"\"Detect stocks hitting 52-week highs\"\"\"\n",
    "        conn = sqlite3.connect(self.db_path)\n",
    "        query = '''\n",
    "            SELECT s.ticker, s.close, \n",
    "                   MAX(s.close) OVER (PARTITION BY s.ticker \n",
    "                       ORDER BY s.date ROWS BETWEEN 252 PRECEDING AND CURRENT ROW) as high_52w\n",
    "            FROM stocks s\n",
    "            WHERE s.date = (SELECT MAX(date) FROM stocks)\n",
    "            AND s.close >= \n",
    "                (SELECT MAX(close) FROM stocks s2 \n",
    "                 WHERE s2.ticker = s.ticker \n",
    "                 AND s2.date >= datetime((SELECT MAX(date) FROM stocks), '-1 year'))\n",
    "        '''\n",
    "        df = pd.read_sql_query(query, conn)\n",
    "        conn.close()\n",
    "        \n",
    "        insights = []\n",
    "        for _, row in df.iterrows():\n",
    "            insights.append({\n",
    "                'type': '52W_HIGH',\n",
    "                'ticker': row['ticker'],\n",
    "                'magnitude': float(row['close']),\n",
    "                'headline': f\"{row['ticker']} reached new 52-week high\",\n",
    "                'description': f\"Highest price in 12 months\"\n",
    "            })\n",
    "        \n",
    "        return insights\n",
    "    \n",
    "    def generate_all_insights(self):\n",
    "        \"\"\"Generate all insights for the day\"\"\"\n",
    "        insights = []\n",
    "        insights.extend(self.detect_high_gainers())\n",
    "        insights.extend(self.detect_unusual_volume())\n",
    "        insights.extend(self.detect_52_week_high())\n",
    "        \n",
    "        return insights\n",
    "\n",
    "# Test insight generator\n",
    "print(\"🔄 Generating insights...\")\n",
    "ig = InsightGenerator(DB_PATH)\n",
    "insights = ig.generate_all_insights()\n",
    "print(f\"✅ Generated {len(insights)} insights\")\n",
    "if insights:\n",
    "    print(f\"Sample insight: {insights[0]}\")"
   ]
