    "## Part 9: Database Query & Analytics Dashboard"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "import pandas as pd\n",
    "import sqlite3\n",
    "from datetime import datetime, timedelta\n",
    "\n",
    "class Dashboard:\n",
    "    \"\"\"Query and visualize data\"\"\"\n",
    "    \n",
    "    def __init__(self, db_path):\n",
    "        self.db_path = db_path\n",
    "    \n",
    "    def get_recent_insights(self, days=7):\n",
    "        \"\"\"Get insights from last N days\"\"\"\n",
    "        conn = sqlite3.connect(self.db_path)\n",
    "        query = f'''\n",
    "            SELECT date, insight_type, ticker, headline, final_score\n",
    "            FROM insights\n",
    "            WHERE date >= date('now', '-{days} days')\n",
    "            ORDER BY date DESC, final_score DESC\n",
    "        '''\n",
    "        df = pd.read_sql_query(query, conn)\n",
    "        conn.close()\n",
    "        return df\n",
    "    \n",
    "    def get_top_gainers(self, limit=10):\n",
    "        \"\"\"Get top performing stocks today\"\"\"\n",
    "        conn = sqlite3.connect(self.db_path)\n",
    "        query = f'''\n",
    "            SELECT ticker, close, \n",
    "                   ROUND(((close - prev_close) / prev_close * 100), 2) as return_pct\n",
    "            FROM stocks\n",
    "            WHERE date = (SELECT MAX(date) FROM stocks)\n",
    "            ORDER BY return_pct DESC\n",
    "            LIMIT {limit}\n",
    "        '''\n",
    "        df = pd.read_sql_query(query, conn)\n",
    "        conn.close()\n",
    "        return df\n",
    "    \n",
    "    def get_insight_statistics(self):\n",
    "        \"\"\"Get insights statistics\"\"\"\n",
    "        conn = sqlite3.connect(self.db_path)\n",
    "        \n",
    "        stats = {}\n",
    "        \n",
    "        # Total insights\n",
    "        total = pd.read_sql_query('SELECT COUNT(*) as count FROM insights', conn)\n",
    "        stats['total_insights'] = int(total['count'][0])\n",
    "        \n",
    "        # By type\n",
    "        by_type = pd.read_sql_query(\n",
    "            'SELECT insight_type, COUNT(*) as count FROM insights GROUP BY insight_type',\n",
    "            conn\n",
    "        )\n",
    "        stats['by_type'] = dict(zip(by_type['insight_type'], by_type['count']))\n",
    "        \n",
    "        # Average score\n",
    "        avg_score = pd.read_sql_query('SELECT AVG(final_score) as avg FROM insights', conn)\n",
    "        stats['avg_score'] = float(avg_score['avg'][0]) if avg_score['avg'][0] else 0\n",
    "        \n",
    "        conn.close()\n",
    "        return stats\n",
    "    \n",
    "    def print_dashboard(self):\n",
    "        \"\"\"Print formatted dashboard\"\"\"\n",
    "        print(\"\\n\" + \"=\"*80)\n",
    "        print(\"📊 MARKETPULSE AI - ANALYTICS DASHBOARD\")\n",
    "        print(\"=\"*80)\n",
    "        \n",
    "        # Statistics\n",
    "        stats = self.get_insight_statistics()\n",
