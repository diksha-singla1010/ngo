    "            price_change='• RELIANCE: +5%\\n• TCS: +3%',\n",
    "            market_comparison='NIFTY: +0.5%'\n",
    "        )\n",
    "        \n",
    "        return script\n",
    "    \n",
    "    @staticmethod\n",
    "    def generate_storyboard(script, insight):\n",
    "        \"\"\"Convert script to storyboard (scenes)\"\"\"\n",
    "        \n",
    "        storyboard = {\n",
    "            'scenes': [\n",
    "                {\n",
    "                    'duration': 5,\n",
    "                    'type': 'HOOK',\n",
    "                    'text': insight['headline'],\n",
    "                    'elements': ['text', 'background_music']\n",
