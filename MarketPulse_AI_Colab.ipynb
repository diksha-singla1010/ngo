  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "from moviepy.editor import (\n",
    "    ImageClip, TextClip, CompositeVideoClip, \n",
    "    concatenate_videoclips, ColorClip, CompositeAudioFileClip\n",
    ")\nfrom moviepy.video.io.ffmpeg_tools import ffmpeg_extract_subclip\nimport numpy as np\nfrom PIL import Image, ImageDraw\nimport io\n\nclass VideoRenderer:\n    \"\"\"Render video from storyboard and doodles\"\"\"\n    \n    FPS = 30\n    RESOLUTION = (1080, 1920)  # Instagram Reels format\n    \n    @staticmethod\n    def svg_to_image(svg_string, width=1080, height=1920):\n        \"\"\"Convert SVG to PIL Image\"\"\"\n        # For Colab, we'll create simple PNG backgrounds instead\n        img = Image.new('RGB', (width, height), color='#0f3460')\n        draw = ImageDraw.Draw(img)\n        \n        # Add gradient effect\n        for y in range(height):\n            ratio = y / height\n            r = int(15 + (50 - 15) * ratio)\n            g = int(52 + (80 - 52) * ratio)\n            b = int(96 + (120 - 96) * ratio)\n            draw.line([(0, y), (width, y)], fill=(r, g, b))\n        \n        return img\n    \n    @staticmethod\n    def create_text_frame(text, duration=3, width=1080, height=1920):\n        \"\"\"Create a text overlay frame\"\"\"\n        txt_clip = TextClip(\n            text,\n            fontsize=60,\n            color='white',\n            font='Arial-Bold',\n            size=(width-100, height-200)\n        ).set_duration(duration)\n        \n        return txt_clip\n    \n    @staticmethod\n    def render_video(storyboard, insight, output_path='/content/output_video.mp4'):\n        \"\"\"Render complete video from storyboard\"\"\"\n        \n        clips = []\n        \n        # Scene 1: Title/Hook (5 seconds)\n        hook_img = VideoRenderer.svg_to_image(\"\", 1080, 1920)\n        hook_clip = ImageClip(np.array(hook_img)).set_duration(5)\n        \n        # Add text overlay\n        text_clip = TextClip(\n            insight['headline'],\n            fontsize=80,\n            color='white',\n            font='Arial-Bold',\n            method='caption',\n            size=(1000, 1000)\n        ).set_duration(5).set_position('center')\n        \n        # Composite hook scene\n        hook_scene = CompositeVideoClip([hook_clip, text_clip])\n        clips.append(hook_scene)\n        \n        # Scene 2: Chart (8 seconds)\n        chart_img = VideoRenderer.svg_to_image(\"\", 1080, 1920)\n        chart_clip = ImageClip(np.array(chart_img)).set_duration(8)\n        \n        chart_text = TextClip(\n            f\"Market Data for {insight.get('ticker', 'Stock')}\",\n            fontsize=50,\n            color='#22c55e',\n            font='Arial'\n        ).set_duration(8).set_position(('center', 100))\n        \n        chart_scene = CompositeVideoClip([chart_clip, chart_text])\n        clips.append(chart_scene)\n        \n        # Scene 3: Stats (8 seconds)\n        stats_img = VideoRenderer.svg_to_image(\"\", 1080, 1920)\n        stats_clip = ImageClip(np.array(stats_img)).set_duration(8)\n        \n        stats_text = TextClip(\n            f\"Magnitude: {insight['magnitude']:.2f}\\nScore: {insight['final_score']:.2f}\",\n            fontsize=60,\n            color='#e0e0e0',\n            font='Arial'\n        ).set_duration(8).set_position('center')\n        \n        stats_scene = CompositeVideoClip([stats_clip, stats_text])\n        clips.append(stats_scene)\n        \n        # Final video\n        final_video = concatenate_videoclips(clips)\n        \n        # Export\n        print(f\"🎬 Rendering video to {output_path}...\")\n        final_video.write_videofile(\n            output_path,\n            fps=VideoRenderer.FPS,\n            codec='libx264',\n            audio_codec='aac',\n            verbose=False,\n            logger=None\n        )\n        \n        print(f\"✅ Video saved to {output_path}\")\n        return output_path\n\nprint(\"✅ VideoRenderer class ready\")\nprint(\"Note: Full video rendering requires additional setup\")"
   ]
